<?xml version="1.0" encoding="utf-8"?>
<!--
  Vanilla Temperature Expanded 的 XML 侧适配。

  为什么需要：
    VTE 的四个自定义温控类（Building_AcUnit / Building_HeaterWithOffset /
    Building_TwoCellHeater / Building_TwoCellCooler）由 C# 模块接管物理输出，
    但它们的 Def 上没有 AO 的建筑大气参数，AO 会按「普通建筑」估算它们的
    抗风/抗压能力，风灾和压差破坏的判定会偏离设计意图。
    管道类建筑则应该完全不漏气，否则一条穿墙风管会把整个房间的气密性废掉。

  与 C# 模块的关系：
    - 本文件只补 Def 数据，不改变任何行为；删掉它 C# 模块仍然工作。
    - 整个文件包在 PatchOperationFindMod 里，VTE 不存在时整段跳过。
-->
<Patch>

  <Operation Class="PatchOperationFindMod">
    <mods>
      <li>VanillaExpanded.Temperature</li>
    </mods>

    <match Class="PatchOperationSequence">
      <operations>

        <!-- 风管、地下风管、风阀：不参与房间空气交换，也不该被风吹坏 -->
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/ThingDef[defName="VTE_AirDuct" or defName="VTE_UndergroundAirDuct" or defName="VTE_VentValve"]</xpath>
          <value>
            <li Class="AtmosphereOverhaul.Simulation.BuildingAtmosphereExtension">
              <airLeakFactor>0</airLeakFactor>
              <pressureToleranceFactor>1000000</pressureToleranceFactor>
              <windToleranceFactor>10</windToleranceFactor>
            </li>
          </value>
        </li>

        <!-- VTE 自有的温控设备：耐压/抗风与 AO 对原版 Cooler 的处理保持一致 -->
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/ThingDef[defName="VTE_ACUnit" or defName="VTE_ACUnitWall" or defName="VTE_IndustrialHeater" or defName="VTE_IndustrialCooler" or defName="VTE_WallHeater" or defName="VTE_WallMountedHeater" or defName="VTE_WallMountedCooler" or defName="VTE_WallMountedVent" or defName="VTE_StandingCooler"]</xpath>
          <value>
            <li Class="AtmosphereOverhaul.Simulation.BuildingAtmosphereExtension">
              <pressureToleranceFactor>2</pressureToleranceFactor>
              <windToleranceFactor>1.7</windToleranceFactor>
            </li>
          </value>
        </li>

        <!-- 控制终端：室内设备，不应成为漏气点 -->
        <li Class="PatchOperationAddModExtension">
          <xpath>/Defs/ThingDef[defName="VTE_ACControlUnit"]</xpath>
          <value>
            <li Class="AtmosphereOverhaul.Simulation.BuildingAtmosphereExtension">
              <airLeakFactor>0</airLeakFactor>
              <pressureToleranceFactor>4</pressureToleranceFactor>
              <windToleranceFactor>2</windToleranceFactor>
            </li>
          </value>
        </li>

      </operations>
    </match>
  </Operation>

</Patch>
