<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef ParentName="BuildingBase">
    <defName>OuterrealmTech_OuterrealmLinkProjector</defName>
    <label>outerrealm link projector</label>
    <description>A control structure that projects outerrealm links directly onto the world map.</description>
    <thingClass>OuterrealmTechRoadProject.Buildings.Building_OuterrealmLinkProjector</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/OuterrealmTech_OuterrealmLinkProjector</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
      <!-- (绘制高度 - 实际高度) / 2  -->
      <!-- (3 - 2) / 2 = 0.5 -->
      <drawOffset>(0, 0, 0.5)</drawOffset>
      <shadowData>
        <!-- 阴影盒子的尺寸 -->
        <!-- 宽度 = 3  高度/厚度/太阳斜射时拉出的阴影 = 0.5  长度/高度 = 2 -->
        <volume>(3, 0.5, 2)</volume>
        <!-- 阴影盒子的中心点偏移 -->
        <!-- Z (上下偏移 = -0.5) 默认情况下，阴影盒子的中心会自动对齐 3x3 贴图的中心（即高度为 1.5 的中线位置） -->
        <!-- 为了让阴影盒子从贴图中心（1.5）向下移动到实际占地的中心（1.0），需要让它在 Z 轴上向下移动 0.5 格。在游戏底层的坐标系中，向下就是负方向，因此输入 -0.5。 -->
        <offset>(0, 0, -0.5)</offset>
      </shadowData>
    </graphicData>
    <uiIconPath>Things/Building/Production/OuterrealmTech_OuterrealmLinkProjector</uiIconPath>
    <size>(3,2)</size>

    <designationCategory>OmniCrafter_Category</designationCategory> <!-- 所在的建筑栏 -->
    
    <altitudeLayer>Building</altitudeLayer>
    <minifiedDef>MinifiedThing</minifiedDef>
    <thingCategories>
      <li>BuildingsMisc</li>
    </thingCategories>
    <statBases>
      <MaxHitPoints>300</MaxHitPoints>
      <WorkToBuild>1</WorkToBuild>
      <Flammability>0</Flammability>
      <Mass>20</Mass>
    </statBases>
    <size>(3,2)</size>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <fillPercent>0</fillPercent>
    <uiOrder>2200</uiOrder>
    <rotatable>true</rotatable>
    <building>
      <destroySound>BuildingDestroyed_Metal_Medium</destroySound>
    </building>
  </ThingDef>
</Defs>
