<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>OuterrealmArchotechTeleportPortal</defName>
    <label>Outerrealm archotech teleport portal</label>
    <description>An ancient OuterrealmTech portal that can bridge active teleport stations across the world.</description>
    <thingClass>OuterrealmArchotechTeleportStation.Building_OuterrealmArchotechTeleportPortal</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/OuterrealmArchotechTeleportStation</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
    </graphicData>
    <uiIconPath>Things/Building/Production/OuterrealmArchotechTeleportStation</uiIconPath>
    <size>(3,2)</size>

    <designationCategory>OmniCrafter_Category</designationCategory> <!-- 所在的建筑栏 -->

    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>

    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>0.4</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <size>(3,2)</size>
    <statBases>
      <!-- 极高的血量，让破墙AI计算后认为破坏它极其不划算，从而绕路 -->
      <MaxHitPoints>999999999</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Flammability>0</Flammability> <!-- 不可燃 -->
      <Beauty>100</Beauty>
      <Mass>50</Mass>
    </statBases>
    <costList>
      <Steel>250</Steel>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <!-- 进一步告诉普通AI不要闲着没事砸它 -->
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <!-- 标记该建筑是"惰性的"——它不会被 AI 主动选为拆除目标 -->
      <isInert>true</isInert>
    </building>
    <rotatable>false</rotatable>
    <hasInteractionCell>false</hasInteractionCell>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <uiOrder>2101</uiOrder>
    <constructionSkillPrerequisite>18</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>

    <comps>
      <li Class="FullyAutomaticOmniCrafter.CompProperties_AbsorbAllDamage" />
    </comps>
    
  </ThingDef>

</Defs>
