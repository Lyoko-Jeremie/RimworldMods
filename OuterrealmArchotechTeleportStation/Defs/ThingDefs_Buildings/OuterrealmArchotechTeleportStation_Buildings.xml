<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>OuterrealmArchotechTeleportPortal</defName>
    <label>Outerrealm archotech teleport portal</label>
    <description>An ancient OuterrealmTech portal that can bridge active teleport stations across the world.</description>
    <thingClass>OuterrealmArchotechTeleportStation.Building_OuterrealmArchotechTeleportPortal</thingClass>
    <graphicData>
      <texPath>Things/Building/Production/OuterrealmArchotechTeleportStation</texPath>
      <graphicClass>Graphic_Single</graphicClass>
      <shaderType>CutoutComplex</shaderType>
      <drawSize>(3,3)</drawSize>
      <!-- (绘制高度 - 实际高度) / 2  -->
      <!-- (3 - 2) / 2 = 0.5 -->
      <drawOffset>(0, 0, 0.5)</drawOffset>
      <shadowData>
        <!-- 阴影盒子的尺寸 -->
        <!-- 宽度 = 3  高度/厚度/太阳斜射时拉出的阴影 = 0.5  长度/高度 = 2 -->
        <volume>(3, 0.5, 2)</volume>
        <!-- 阴影盒子的中心点偏移 -->
        <!-- Z (上下偏移 = -0.5) 默认情况下，阴影盒子的中心会自动对齐 3x3 贴图的中心（即高度为 1.5 的中线位置） -->
        <!-- 为了让阴影盒子从贴图中心（1.5）向下移动到实际占地的中心（1.0），需要让它在 Z 轴上向下移动 0.5 格。在游戏底层的坐标系中，向下就是负方向，因此输入 -0.5。 -->
<!--        <offset>(0, 0, -0.5)</offset>-->
        <offset>(0, 0, 0)</offset>
      </shadowData>
    </graphicData>
    <uiIconPath>Things/Building/Production/OuterrealmArchotechTeleportStation</uiIconPath>
    <size>(3,2)</size>

    <designationCategory>OmniCrafter_Category</designationCategory> <!-- 所在的建筑栏 -->

<!--    <thingCategories>-->
<!--      <li>BuildingsProduction</li>-->
<!--    </thingCategories>-->

    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>0.4</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <size>(3,2)</size>
    <statBases>
      <!-- 极高的血量，让破墙AI计算后认为破坏它极其不划算，从而绕路 -->
      <MaxHitPoints>999999999</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Flammability>0</Flammability> <!-- 不可燃 -->
      <Beauty>100</Beauty>
      <Mass>50</Mass>
    </statBases>
    <costList>
      <Steel>250</Steel>
    </costList>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
      <!-- 进一步告诉普通AI不要闲着没事砸它 -->
      <ai_neverTrashThis>true</ai_neverTrashThis>
      <!-- 标记该建筑是"惰性的"——它不会被 AI 主动选为拆除目标 -->
      <isInert>true</isInert>
    </building>
    <rotatable>false</rotatable>
    <hasInteractionCell>false</hasInteractionCell>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <uiOrder>2101</uiOrder>
    <constructionSkillPrerequisite>18</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>

    <comps>
      <li Class="FullyAutomaticOmniCrafter.CompProperties_AbsorbAllDamage" />
    </comps>
    
  </ThingDef>

</Defs>
