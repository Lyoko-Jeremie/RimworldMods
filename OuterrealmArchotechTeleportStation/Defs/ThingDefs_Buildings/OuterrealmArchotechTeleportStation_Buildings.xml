<?xml version="1.0" encoding="utf-8" ?>
<Defs>

  <ThingDef ParentName="BuildingBase">
    <defName>OuterrealmArchotechTeleportPortal</defName>
    <label>Outerrealm archotech teleport portal</label>
    <description>An ancient OuterrealmTech portal that can bridge active teleport stations across the world.</description>
    <thingClass>OuterrealmArchotechTeleportStation.Building_OuterrealmArchotechTeleportPortal</thingClass>
    <graphicData>
      <texPath>Things/Building/Misc/CommsConsole</texPath>
      <graphicClass>Graphic_Multi</graphicClass>
      <drawSize>(3,2)</drawSize>
      <shadowData>
        <volume>(2,0.5,1)</volume>
      </shadowData>
    </graphicData>

    <designationCategory>OmniCrafter_Category</designationCategory> <!-- 所在的建筑栏 -->

    <thingCategories>
      <li>BuildingsProduction</li>
    </thingCategories>

    <altitudeLayer>Building</altitudeLayer>
    <passability>PassThroughOnly</passability>
    <pathCost>30</pathCost>
    <blockWind>true</blockWind>
    <castEdgeShadows>false</castEdgeShadows>
    <fillPercent>0.4</fillPercent>
    <canOverlapZones>false</canOverlapZones>
    <size>(3,2)</size>
    <building>
      <destroySound>BuildingDestroyed_Metal_Big</destroySound>
    </building>
    <statBases>
      <MaxHitPoints>600</MaxHitPoints>
      <WorkToBuild>2400</WorkToBuild>
      <Flammability>0</Flammability>
      <Beauty>8</Beauty>
    </statBases>
    <costList>
      <Steel>250</Steel>
      <Plasteel>80</Plasteel>
      <ComponentSpacer>4</ComponentSpacer>
    </costList>
    <defaultPlacingRot>South</defaultPlacingRot>
<!--    <interactionCellOffset>(0,0,-1)</interactionCellOffset>-->
    <hasInteractionCell>false</hasInteractionCell>
    <terrainAffordanceNeeded>Medium</terrainAffordanceNeeded>
    <uiOrder>2101</uiOrder>
    <constructionSkillPrerequisite>8</constructionSkillPrerequisite>
    <placeWorkers>
      <li>PlaceWorker_PreventInteractionSpotOverlap</li>
    </placeWorkers>
  </ThingDef>

</Defs>
