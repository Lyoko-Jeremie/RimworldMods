  <!-- 内容 Tab -->
  <TabOuterrealmVaultContents>内容</TabOuterrealmVaultContents>

  <!-- 出入三开关（§4.1c/d） -->
  <VaultAllowDeposit>允许存入</VaultAllowDeposit>
  <VaultAllowDepositDesc>开启后，搬运工可将物品存入本建筑（默认开启）。</VaultAllowDepositDesc>
  <VaultAllowWithdraw>允许取出</VaultAllowWithdraw>
  <VaultAllowWithdrawDesc>开启后，搬运工可自动取走内容，工作台原料与进食/治疗搜索可见本建筑内容（默认开启）。</VaultAllowWithdrawDesc>
  <VaultAllowTakeForUse>禁止取出时允许拿取</VaultAllowTakeForUse>
  <VaultAllowTakeForUseDesc>关闭"允许取出"时，开启此项可让工作台原料与进食/治疗搜索仍看到本建筑内容（搬运工搬运仍被禁止）。</VaultAllowTakeForUseDesc>
  <VaultAllowTakeForUseDisabledReason>需先关闭"允许取出"</VaultAllowTakeForUseDisabledReason>
  <!-- 冻结开关 -->
  <VaultFrozen>冻结</VaultFrozen>
  <VaultFrozenDesc>开启后隐藏本建筑内的全部物品并暂停其工作（存储清单 filter 保持不变，物品仍保存在超维空间）。关闭后恢复显示。</VaultFrozenDesc>

