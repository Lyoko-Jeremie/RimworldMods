<?xml version="1.0" encoding="utf-8"?>
<LanguageData>

  <!-- 超维存储（OuterrealmStorage）-->

  <!-- InspectString -->
  <OuterrealmVault_InspectSummary>超维存储：{0} 类物品，共 {1} 件</OuterrealmVault_InspectSummary>
  <OuterrealmVault_InspectEmpty>超维存储：空</OuterrealmVault_InspectEmpty>



  <!-- 内容 Tab -->
  <TabOuterrealmVaultContents>内容</TabOuterrealmVaultContents>

  <!-- 出入三开关（§4.1c/d） -->
  <VaultNoDeposit>禁止存入</VaultNoDeposit>
  <VaultNoDepositDesc>开启后，搬运工不再把本建筑作为存储目标（只出不入）。</VaultNoDepositDesc>
  <VaultNoWithdraw>禁止取出</VaultNoWithdraw>
  <VaultNoWithdrawDesc>开启后，搬运工不能自动取走内容，同时关闭工作台原料与进食/治疗搜索，除非开启"允许拿取"。</VaultNoWithdrawDesc>
  <VaultAllowTakeForUse>禁止取出时允许拿取</VaultAllowTakeForUse>
  <VaultAllowTakeForUseDesc>开启后，在"禁止取出"状态下，工作台原料与进食/治疗搜索仍可看到本建筑内容（搬运工搬运仍被禁止）。</VaultAllowTakeForUseDesc>
  <VaultAllowTakeForUseDisabledReason>需先开启"禁止取出"</VaultAllowTakeForUseDisabledReason>
  <!-- 移出/放行（§6.3） -->
  <OuterrealmVault_Release>移出该类</OuterrealmVault_Release>
  <OuterrealmVault_StopRelease>停止移出</OuterrealmVault_StopRelease>
  <OuterrealmVault_ReleaseAll>移出全部</OuterrealmVault_ReleaseAll>
  <OuterrealmVault_StopReleaseAll>停止移出全部</OuterrealmVault_StopReleaseAll>
  <OuterrealmVault_ReleaseAllDesc>放行全部条目，搬运工会把它们搬到其他允许的存储区（物品从超维空间取出）。条目搬空后放行状态自动清除。</OuterrealmVault_ReleaseAllDesc>

  <!-- 全局管理面板（§6.4） -->
  <OuterrealmStorageManagerTitle>超维存储管理器</OuterrealmStorageManagerTitle>
  <OuterrealmStorageManager_Total>共 {0} 类条目，{1} 件</OuterrealmStorageManager_Total>
  <OuterrealmStorageManager_EjectProgress>弹出中：{0} 件剩余</OuterrealmStorageManager_EjectProgress>
  <OuterrealmStorageManager_ShowOnlyUnseen>仅显示不可见条目</OuterrealmStorageManager_ShowOnlyUnseen>
  <OuterrealmStorageManager_SelectMap>目标地图</OuterrealmStorageManager_SelectMap>
  <OuterrealmStorageManager_Eject>弹出</OuterrealmStorageManager_Eject>
  <OuterrealmStorageManager_EjectAll>全部弹出</OuterrealmStorageManager_EjectAll>
  <OuterrealmStorageManager_Unseen>不可见</OuterrealmStorageManager_Unseen>
  <OuterrealmStorageManager_VisibleBuildings>{0} 座终端可见</OuterrealmStorageManager_VisibleBuildings>
  <OuterrealmStorageManager_NoEntries>超维存储为空</OuterrealmStorageManager_NoEntries>
  <OuterrealmStorageManager_Open>打开全局存储管理器</OuterrealmStorageManager_Open>
  <OuterrealmStorageManager_OpenDesc>查看超维空间中的全部内容（无视任何终端的存储清单），可强制弹出或转移到指定地图。</OuterrealmStorageManager_OpenDesc>

  <!-- 取到背包（§6.1） -->
