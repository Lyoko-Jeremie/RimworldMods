<?xml version="1.0" encoding="utf-8"?>
<LanguageData>
    <!-- 自动物品收集器 Gizmo -->
    <AutoItemCollector_Toggle>启用收集</AutoItemCollector_Toggle>
    <AutoItemCollector_ToggleDesc>启用或禁用本收集器。禁用后完全不扫描、不搬运。</AutoItemCollector_ToggleDesc>
    <AutoItemCollector_ManualPause>手动暂停</AutoItemCollector_ManualPause>
    <AutoItemCollector_ManualPauseDesc>手动暂停时完全停止扫描；再次点击恢复。目标已满/筛选器不匹配等自动状态只显示在详细信息中，不会改变此开关。</AutoItemCollector_ManualPauseDesc>
    <AutoItemCollector_ScanInterval>扫描间隔：{0} tick</AutoItemCollector_ScanInterval>
    <AutoItemCollector_ScanIntervalDesc>每隔多少 tick 扫描一次。间隔越小吞吐越高，但全图扫描越频繁。</AutoItemCollector_ScanIntervalDesc>
    <AutoItemCollector_ScanIntervalOption>{0} tick</AutoItemCollector_ScanIntervalOption>
    <AutoItemCollector_CurrentOption>✓ {0}</AutoItemCollector_CurrentOption>
    <AutoItemCollector_MaxStacks>每周期上限：{0} 组</AutoItemCollector_MaxStacks>
    <AutoItemCollector_MaxStacksDesc>每次请求最多搬运多少组。一组是一个堆叠（一格），不是“每周期只能 1 组”。</AutoItemCollector_MaxStacksDesc>
    <AutoItemCollector_MaxStacksOption>{0} 组</AutoItemCollector_MaxStacksOption>
    <AutoItemCollector_TargetMode>目标模式：{0}</AutoItemCollector_TargetMode>
    <AutoItemCollector_TargetModeDesc>自动：按原版优先级选择最优存储；手动：严格只送入指定的目标存储。</AutoItemCollector_TargetModeDesc>
    <AutoItemCollector_ModeAutomatic>自动（原版优先级）</AutoItemCollector_ModeAutomatic>
    <AutoItemCollector_ModeManual>手动指定</AutoItemCollector_ModeManual>
    <AutoItemCollector_SelectArea>活动区：{0}</AutoItemCollector_SelectArea>
    <AutoItemCollector_SelectAreaDesc>选择收集扫描范围。全图表示不限制活动区。</AutoItemCollector_SelectAreaDesc>
    <AutoItemCollector_WholeMap>全图</AutoItemCollector_WholeMap>
    <AutoItemCollector_SelectTarget>选择目标存储</AutoItemCollector_SelectTarget>
    <AutoItemCollector_SelectTargetDesc>用十字光标点击地图上的存储区、存储建筑或容器型存储。</AutoItemCollector_SelectTargetDesc>
    <AutoItemCollector_SelectTargetFromList>从列表选择目标</AutoItemCollector_SelectTargetFromList>
    <AutoItemCollector_SelectTargetFromListDesc>列出本图所有可用的存储区、存储建筑、容器和超维存储终端。</AutoItemCollector_SelectTargetFromListDesc>
    <AutoItemCollector_TargetOption>{0}（{1}）</AutoItemCollector_TargetOption>
    <AutoItemCollector_TargetOptionVault>{0}（{1}，超维存储）</AutoItemCollector_TargetOptionVault>
    <AutoItemCollector_NoTargets>本图没有可用的目标存储</AutoItemCollector_NoTargets>
    <AutoItemCollector_TargetAutomatic>按原版优先级自动选择</AutoItemCollector_TargetAutomatic>
    <AutoItemCollector_TargetNone>未选择</AutoItemCollector_TargetNone>

    <!-- 填充可达性 -->
    <AutoItemCollector_Reachability>填充范围：{0}</AutoItemCollector_Reachability>
    <AutoItemCollector_ReachabilityDesc>控制替代搬运时如何判断目标是否可达。全图：只判断目标是否有效，不受墙体/距离限制；仅物理连通：从本建筑出发按普通 Pawn 的连通性判断（包含敌方阵地，不额外排除）。</AutoItemCollector_ReachabilityDesc>
    <AutoItemCollector_ReachabilityWholeMap>全图</AutoItemCollector_ReachabilityWholeMap>
    <AutoItemCollector_ReachabilityPhysicalOnly>仅物理连通</AutoItemCollector_ReachabilityPhysicalOnly>
    <AutoItemCollector_FillInterval>填充间隔：{0} tick</AutoItemCollector_FillInterval>
    <AutoItemCollector_FillIntervalDesc>每隔多少 tick 为燃料建筑、运输舱、料斗等补一次料。默认 60 tick（1 秒）；越小响应越快，但全图判定越频繁。</AutoItemCollector_FillIntervalDesc>
    <AutoItemCollector_FillIntervalOption>{0} tick</AutoItemCollector_FillIntervalOption>

    <!-- 开发期自检 -->
    <AutoItemCollector_SelfCheckJudge>自检判定 Pawn</AutoItemCollector_SelfCheckJudge>
    <AutoItemCollector_SelfCheckJudgeDesc>生成判定 Pawn，并打印进入/退出窗口前后的 Spawned/Map/Position 状态。</AutoItemCollector_SelfCheckJudgeDesc>

    <!-- 详细信息 -->
    <AutoItemCollector_InspectStatus>状态：{0}</AutoItemCollector_InspectStatus>
    <AutoItemCollector_InspectTarget>目标：{0}</AutoItemCollector_InspectTarget>
    <AutoItemCollector_InspectArea>活动区：{0}</AutoItemCollector_InspectArea>
    <AutoItemCollector_InspectInterval>扫描间隔：{0} tick</AutoItemCollector_InspectInterval>
    <AutoItemCollector_InspectMaxStacks>每周期上限：{0} 组</AutoItemCollector_InspectMaxStacks>

    <!-- 状态 -->
    <AutoItemCollector_StatusDisabled>已停用</AutoItemCollector_StatusDisabled>
    <AutoItemCollector_StatusManualPaused>手动暂停</AutoItemCollector_StatusManualPaused>
    <AutoItemCollector_StatusRunning>运行中</AutoItemCollector_StatusRunning>
    <AutoItemCollector_StatusIdle>空闲</AutoItemCollector_StatusIdle>
    <AutoItemCollector_StatusFull>目标已满</AutoItemCollector_StatusFull>
    <AutoItemCollector_StatusFilterMismatch>筛选器不匹配</AutoItemCollector_StatusFilterMismatch>
    <AutoItemCollector_StatusTargetInvalid>目标失效</AutoItemCollector_StatusTargetInvalid>
    <AutoItemCollector_StatusAreaEmpty>活动区为空</AutoItemCollector_StatusAreaEmpty>

    <!-- 多选 -->
    <AutoItemCollector_MixedValue>多值</AutoItemCollector_MixedValue>
    <AutoItemCollector_MultiSelectDisabled>多选时不可用</AutoItemCollector_MultiSelectDisabled>
</LanguageData>
