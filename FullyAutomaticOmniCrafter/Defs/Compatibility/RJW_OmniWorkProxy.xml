<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!--
        使用 RJW 公开的 RaceGroupDef 接口声明万能工作站代理不具有性需求、生育或怀孕能力。
        PawnKind 精确匹配优先于代理所共用的 Human 种族组；行为层隔离由可选 Harmony 兼容补丁负责。
    -->
    <rjw.RaceGroupDef MayRequire="rim.job.world">
        <defName>FAOC_OmniWorkProxy_NoSex_Group</defName>
        <pawnKindNames>
            <li>FAOC_OmniWorkProxy</li>
        </pawnKindNames>
        <hasSexNeed>false</hasSexNeed>
        <hasFertility>false</hasFertility>
        <hasPregnancy>false</hasPregnancy>
    </rjw.RaceGroupDef>
</Defs>
