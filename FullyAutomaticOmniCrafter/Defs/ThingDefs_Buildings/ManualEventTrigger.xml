<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <DesignatorDropdownGroupDef>
        <defName>ManualEventTrigger_DropdownGroup</defName>
    </DesignatorDropdownGroupDef>

    <ThingDef Name="ManualEventTrigger" ParentName="BuildingBase">
        <defName>ManualEventTrigger</defName>
        <label>ManualEventTrigger</label>
        <description>description</description>

        <tickerType>Never</tickerType>

        <!-- 下拉菜单配置放在父类，子类自动继承 -->
        <designatorDropdown>ManualEventTrigger_DropdownGroup</designatorDropdown>
        <designationCategory>OmniCrafter_Category</designationCategory> <!-- 所在的建筑栏 -->

        <graphicData>
            <texPath>Things/Building/Production/ManualEventTrigger</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <shaderType>CutoutComplex</shaderType>
            <drawSize>(3,3)</drawSize>
            <!-- (绘制高度 - 实际高度) / 2  -->
            <!-- (3 - 2) / 2 = 0.5 -->
            <drawOffset>(0, 0, 0.5)</drawOffset>
        </graphicData>
        <size>(3,2)</size>
        <pathCost>1</pathCost>
        <blockWind>false</blockWind>
        <castEdgeShadows>false</castEdgeShadows>
        <staticSunShadowHeight>0.0</staticSunShadowHeight>
        <fillPercent>0.5</fillPercent>
        <canOverlapZones>false</canOverlapZones>
        <uiIconPath>Things/Building/Production/ManualEventTrigger</uiIconPath>

        <costList>
            <Steel>200</Steel>
        </costList>
        <minifiedDef>MinifiedThing</minifiedDef>

        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>

        <passability>Standable</passability>
        <pathCost>1</pathCost>

        <!-- 2. 欺骗AI的属性 -->
        <statBases>
            <!-- 极高的血量，让破墙AI计算后认为破坏它极其不划算，从而绕路 -->
            <MaxHitPoints>999999999</MaxHitPoints>
            <WorkToBuild>1</WorkToBuild>
            <Flammability>0</Flammability> <!-- 不可燃 -->
            <Beauty>100</Beauty>
            <Mass>50</Mass>
        </statBases>

        <thingCategories>
            <li>BuildingsProduction</li>
        </thingCategories>

        <comps>
            <li Class="FullyAutomaticOmniCrafter.CompProperties_ManualEventTrigger"/>
        </comps>

        <rotatable>false</rotatable>

        <constructEffect>ConstructMetal</constructEffect>
        <repairEffect>Repair</repairEffect>
    </ThingDef>

    <ThingDef ParentName="ManualEventTrigger">
        <defName>ManualEventTrigger_mini</defName>
        <label>ManualEventTrigger mini</label>
        <description>description</description>
        <graphicData>
            <drawSize>(1,1)</drawSize>
            <drawOffset>(0, 0, 0)</drawOffset>
        </graphicData>
        <size>(1,1)</size>
    </ThingDef>

</Defs>
