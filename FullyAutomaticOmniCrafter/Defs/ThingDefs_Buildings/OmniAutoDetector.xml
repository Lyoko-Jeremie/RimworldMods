<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <DesignatorDropdownGroupDef>
        <defName>OmniAutoDetector_DropdownGroup</defName>
    </DesignatorDropdownGroupDef>

    <ThingDef Name="OmniAutoDetector" ParentName="BuildingBase">
        <defName>OmniAutoDetector</defName>
        <label>OmniAutoDetector</label>
        <description>description</description>

        <tickerType>Rare</tickerType>

        <designationCategory>OmniCrafter_Category</designationCategory> <!-- 所在的建筑栏 -->
        
        <size>(3,3)</size>
        <graphicData>
            <texPath>Things/Building/Production/OmniAutoDetector</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(3,3)</drawSize>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <pathCost>1</pathCost>
        <blockWind>false</blockWind>
        <castEdgeShadows>false</castEdgeShadows>
        <staticSunShadowHeight>0.0</staticSunShadowHeight>
        <fillPercent>0.5</fillPercent>
        <canOverlapZones>false</canOverlapZones>
        <uiIconPath>Things/Building/Production/OmniAutoDetector</uiIconPath>

        <costList>
            <Steel>200</Steel>
            <!--            <ComponentIndustrial>8</ComponentIndustrial>-->
            <!--            <ComponentSpacer>4</ComponentSpacer>-->
        </costList>
        <minifiedDef>MinifiedThing</minifiedDef>

        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>

        <passability>Standable</passability>
        <pathCost>1</pathCost>

        <!-- 2. 欺骗AI的属性 -->
        <statBases>
            <!-- 极高的血量，让破墙AI计算后认为破坏它极其不划算，从而绕路 -->
            <MaxHitPoints>999999999</MaxHitPoints>
            <WorkToBuild>1</WorkToBuild>
            <Flammability>0</Flammability> <!-- 不可燃 -->
            <Beauty>100</Beauty>
            <Mass>50</Mass>
        </statBases>

        <thingCategories>
            <li>BuildingsProduction</li>
        </thingCategories>

        <comps>
            <li Class="FullyAutomaticOmniCrafter.CompProperties_OmniAutoDetector"/>
        </comps>

        <rotatable>false</rotatable>

        <constructEffect>ConstructMetal</constructEffect>
        <repairEffect>Repair</repairEffect>
    </ThingDef>
    
    <ThingDef ParentName="OmniAutoDetector">
        <defName>OmniAutoDetector_mini</defName>
        <label>OmniAutoDetector mini</label>
        <description>description</description>
        <graphicData>
            <drawSize>(1,1)</drawSize>
        </graphicData>
        <size>(1,1)</size>
    </ThingDef>
    
</Defs>
