<Defs>
    <DesignationCategoryDef>
        <!-- 这是代码内部使用的 ID，必须唯一 -->
        <defName>OmniCrafter_Category</defName>

        <!-- 这是在游戏底部建筑菜单（Architect Menu）中显示的汉字/文字 -->
        <label>label</label>

        <!-- 鼠标悬停时的文字说明（可选） -->
        <description>description</description>

        <!-- 核心机制：控制这个菜单栏在游戏底部的排列顺序 -->
        <order>750</order>

        <!--
            特殊设计器：幻影墙通行规则批量设置工具。
            必须在此用 XML 声明，不能靠 Harmony 补丁注入 ——
            DesignationCategoryDef.ResolveReferences() 在 def 解析的同步阶段就执行完，
            而 Harmony 补丁要到 StaticConstructorOnStartupUtility.CallAll()（同一批长事件末尾的
            ExecuteWhenFinished 队列）才安装，那时 ResolveDesignators() 已经跑完，
            补丁永远不会生效，工具不会出现在建筑菜单里。
        -->
        <specialDesignatorClasses>
            <li>FullyAutomaticOmniCrafter.Designator_PhantomWall2Passability</li>
        </specialDesignatorClasses>
    </DesignationCategoryDef>
</Defs>
