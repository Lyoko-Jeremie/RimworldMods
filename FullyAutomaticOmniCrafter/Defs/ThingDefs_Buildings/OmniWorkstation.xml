<?xml version="1.0" encoding="utf-8" ?>
<Defs>

<!--    <DesignatorDropdownGroupDef>-->
<!--        <defName>OmniWorkstation_DropdownGroup</defName>-->
<!--    </DesignatorDropdownGroupDef>-->

    <!--
        工作属性必须施加在代理 Pawn 上，建筑 statBases 不会影响 JobDriver 的工作速度。
        这里沿用时空立场投影仪的核心生产属性，但不创建服装及护盾组件，避免额外 Tick 开销。
    -->
    <HediffDef>
        <defName>FAOC_OmniWorkProxyBoost</defName>
        <label>omni work acceleration</label>
        <description>Internal work acceleration used by the universal workstation proxy.</description>
        <hediffClass>Hediff</hediffClass>
        <isBad>false</isBad>
        <everCurableByItem>false</everCurableByItem>
        <duplicationAllowed>false</duplicationAllowed>
        <stages>
            <li>
                <statOffsets>
                    <WorkSpeedGlobal>100000</WorkSpeedGlobal>
                    <CarryingCapacity>10000000</CarryingCapacity>
                    <MoveSpeed>200</MoveSpeed>
                    <ConstructSuccessChance>1</ConstructSuccessChance>
                    <FixBrokenDownBuildingSuccessChance>1</FixBrokenDownBuildingSuccessChance>
                    <SubcoreEncodingSpeed MayRequire="Ludeon.RimWorld.Biotech">30</SubcoreEncodingSpeed>
                    <MechRepairSpeed MayRequire="Ludeon.RimWorld.Biotech">300</MechRepairSpeed>
                    <MechFormingSpeed MayRequire="Ludeon.RimWorld.Biotech">120</MechFormingSpeed>
                    <ButcheryMechanoidEfficiency MayRequire="Ludeon.RimWorld.Biotech">1</ButcheryMechanoidEfficiency>
                    <MentalBreakThreshold>-2</MentalBreakThreshold>
                    <FilthRate>-1.5</FilthRate>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <!-- 仅作为原版工作管线的隐藏执行载体，不拥有独立 AI 后端。 -->
    <PawnKindDef ParentName="BasePlayerPawnKind">
        <defName>FAOC_OmniWorkProxy</defName>
        <label>omni work proxy</label>
        <race>Human</race>
        <combatPower>0</combatPower>
        <!-- Humanlike PawnKindDef 在 1.6 中必须显式定义这两个区间。 -->
        <initialResistanceRange>0~0</initialResistanceRange>
        <initialWillRange>0~0</initialWillRange>
        <startingHediffs>
            <li>
                <def>FAOC_OmniWorkProxyBoost</def>
            </li>
        </startingHediffs>
    </PawnKindDef>

    <ThingDef ParentName="BuildingBase">
        <defName>OmniWorkstation</defName>
        <label>universal workstation</label>
        <description>Automatically performs pawn-operated building work in its configured range through the standard work and job pipeline.</description>
        <thingClass>FullyAutomaticOmniCrafter.Building_OmniWorkstation</thingClass>

<!--        <designatorDropdown>OmniWorkstation_DropdownGroup</designatorDropdown>-->
        <designationCategory>OmniCrafter_Category</designationCategory>

        <graphicData>
            <texPath>Things/Building/Production/OmniCrafter2_l</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1,1)</drawSize>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <uiIconPath>Things/Building/Production/OmniCrafter2_l</uiIconPath>
        <altitudeLayer>Building</altitudeLayer>
        <passability>PassThroughOnly</passability>
        <pathCost>1</pathCost>
        <blockWind>false</blockWind>
        <castEdgeShadows>false</castEdgeShadows>
        <staticSunShadowHeight>0</staticSunShadowHeight>
        <fillPercent>0.5</fillPercent>
        <size>(1,1)</size>

        <costList>
            <Steel>200</Steel>
        </costList>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsProduction</li>
        </thingCategories>
        <statBases>
            <Mass>50</Mass>
            <MaxHitPoints>500</MaxHitPoints>
            <Flammability>0.5</Flammability>
        </statBases>

        <!-- 调度由 MapComponent 集中驱动，建筑本身不需要 Tick。 -->
        <tickerType>Never</tickerType>
        <building>
            <paintable>true</paintable>
        </building>
        <comps>
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Breakdownable" />
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>2000</basePowerConsumption>
                <shortCircuitInRain>false</shortCircuitInRain>
                <transmitsPower>true</transmitsPower>
            </li>
        </comps>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <constructEffect>ConstructMetal</constructEffect>
        <repairEffect>Repair</repairEffect>
        <rotatable>false</rotatable>
    </ThingDef>

</Defs>
