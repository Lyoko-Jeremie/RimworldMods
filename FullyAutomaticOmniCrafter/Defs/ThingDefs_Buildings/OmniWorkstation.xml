<?xml version="1.0" encoding="utf-8" ?>
<Defs>

    <!-- 代理专用空白背景，不参与随机背景池，也不禁用任何工作。 -->
    <BackstoryDef>
        <defName>FAOC_OmniWorkProxyChildhood</defName>
        <identifier>FAOC_OmniWorkProxyChildhood</identifier>
        <slot>Childhood</slot>
        <title>blank work proxy</title>
        <titleShort>work proxy</titleShort>
        <description>An artificial blank background reserved for universal workstation proxies.</description>
        <shuffleable>false</shuffleable>
    </BackstoryDef>

    <BackstoryDef>
        <defName>FAOC_OmniWorkProxyAdulthood</defName>
        <identifier>FAOC_OmniWorkProxyAdulthood</identifier>
        <slot>Adulthood</slot>
        <title>blank work proxy</title>
        <titleShort>work proxy</titleShort>
        <description>An artificial blank background reserved for universal workstation proxies.</description>
        <shuffleable>false</shuffleable>
    </BackstoryDef>

<!--    <DesignatorDropdownGroupDef>-->
<!--        <defName>OmniWorkstation_DropdownGroup</defName>-->
<!--    </DesignatorDropdownGroupDef>-->

    <!--
        工作属性必须施加在代理 Pawn 上，建筑 statBases 不会影响 JobDriver 的工作速度。
        这里沿用时空立场投影仪的核心生产属性，但不创建服装及护盾组件，避免额外 Tick 开销。
    -->
    <HediffDef>
        <defName>FAOC_OmniWorkProxyBoost</defName>
        <label>omni work acceleration</label>
        <description>Internal work acceleration used by the universal workstation proxy.</description>
        <hediffClass>Hediff</hediffClass>
        <isBad>false</isBad>
        <blocksSocialInteraction>true</blocksSocialInteraction>
        <everCurableByItem>false</everCurableByItem>
        <duplicationAllowed>false</duplicationAllowed>
        <stages>
            <li>
                <statOffsets>
                    <WorkSpeedGlobal>100000</WorkSpeedGlobal>
                    <CarryingCapacity>10000000</CarryingCapacity>
                    <MoveSpeed>200000</MoveSpeed>
                    <ConstructSuccessChance>1</ConstructSuccessChance>
                    <FixBrokenDownBuildingSuccessChance>1</FixBrokenDownBuildingSuccessChance>
                    <SubcoreEncodingSpeed MayRequire="Ludeon.RimWorld.Biotech">30</SubcoreEncodingSpeed>
                    <MechRepairSpeed MayRequire="Ludeon.RimWorld.Biotech">300</MechRepairSpeed>
                    <MechFormingSpeed MayRequire="Ludeon.RimWorld.Biotech">120</MechFormingSpeed>
                    <ButcheryMechanoidEfficiency MayRequire="Ludeon.RimWorld.Biotech">1</ButcheryMechanoidEfficiency>
                    <MentalBreakThreshold>-2</MentalBreakThreshold>
                    <FilthRate>-1.5</FilthRate>
                </statOffsets>
            </li>
        </stages>
    </HediffDef>

    <!--
        代理归属的镜像记录。权威归属表在全局组件 GameComponent_OmniWorkProxyRegistry
        （只有它能回答"某个池现在有哪些代理"），这里只在代理身上留一份副本：
        HediffSet 随存档深保存，索引一旦损坏可据此把归属救回来。
        纯数据载体：不参与治疗、不产生任何 stat / thought 效果。
    -->
    <HediffDef>
        <defName>FAOC_OmniWorkProxyHome</defName>
        <label>omni work proxy home</label>
        <description>Internal ownership record of the universal workstation proxy.</description>
        <hediffClass>FullyAutomaticOmniCrafter.Hediff_OmniWorkProxyHome</hediffClass>
        <isBad>false</isBad>
        <tendable>false</tendable>
        <everCurableByItem>false</everCurableByItem>
        <duplicationAllowed>false</duplicationAllowed>
        <blocksSocialInteraction>true</blocksSocialInteraction>
        <stages>
            <li>
                <minSeverity>0</minSeverity>
            </li>
        </stages>
    </HediffDef>

    <!-- 仅作为原版工作管线的隐藏执行载体，不拥有独立 AI 后端。 -->
    <PawnKindDef ParentName="BasePlayerPawnKind">
        <defName>FAOC_OmniWorkProxy</defName>
        <label>omni work proxy</label>
        <race>Human</race>
        <combatPower>0</combatPower>
        <!-- Humanlike PawnKindDef 在 1.6 中必须显式定义这两个区间。 -->
        <initialResistanceRange>0~0</initialResistanceRange>
        <initialWillRange>0~0</initialWillRange>
        <fixedChildBackstories>
            <li>FAOC_OmniWorkProxyChildhood</li>
        </fixedChildBackstories>
        <fixedAdultBackstories>
            <li>FAOC_OmniWorkProxyAdulthood</li>
        </fixedAdultBackstories>
        <startingHediffs>
            <li>
                <def>FAOC_OmniWorkProxyBoost</def>
            </li>
        </startingHediffs>
    </PawnKindDef>

    <ThingDef ParentName="BuildingBase">
        <defName>OmniWorkstation</defName>
        <label>universal workstation</label>
        <description>Automatically performs enabled vanilla and mod work in its configured range through the standard work and job pipeline.</description>
        <thingClass>FullyAutomaticOmniCrafter.Building_OmniWorkstation</thingClass>

<!--        <designatorDropdown>OmniWorkstation_DropdownGroup</designatorDropdown>-->
        <designationCategory>OmniCrafter_Category</designationCategory>

        <graphicData>
            <texPath>Things/Building/Production/OmniWorkstation</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1,1)</drawSize>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <uiIconPath>Things/Building/Production/OmniWorkstation</uiIconPath>
        <altitudeLayer>Building</altitudeLayer>
        <passability>Standable</passability>
        <pathCost>1</pathCost>
        <blockWind>false</blockWind>
        <castEdgeShadows>false</castEdgeShadows>
        <staticSunShadowHeight>0</staticSunShadowHeight>
        <fillPercent>0.5</fillPercent>
        <size>(1,1)</size>

        <costList>
            <Steel>200</Steel>
        </costList>
        <minifiedDef>MinifiedThing</minifiedDef>
        <thingCategories>
            <li>BuildingsProduction</li>
        </thingCategories>
        <statBases>
            <Mass>50</Mass>
            <MaxHitPoints>500</MaxHitPoints>
            <Flammability>0.5</Flammability>
        </statBases>

        <!-- 调度由 MapComponent 集中驱动，建筑本身不需要 Tick。 -->
        <tickerType>Never</tickerType>
        <building>
            <paintable>true</paintable>
<!--            <menuHidden>true</menuHidden>-->
        </building>
        <comps>
            <li Class="CompProperties_Flickable" />
            <li Class="CompProperties_Breakdownable" />
            <!--
                工作站不消耗电力：basePowerConsumption 为 0。
                保留 CompPowerTrader + transmitsPower 只为维持"电网节点"能力，
                这样玩家原有的穿墙布线不会被拆站打断；供电状态也不影响工作
                （Operational 刻意不检查 PowerOn）。
            -->
            <li Class="CompProperties_Power">
                <compClass>CompPowerTrader</compClass>
                <basePowerConsumption>0</basePowerConsumption>
                <shortCircuitInRain>false</shortCircuitInRain>
                <transmitsPower>true</transmitsPower>
            </li>
        </comps>
        <terrainAffordanceNeeded>Light</terrainAffordanceNeeded>
        <constructEffect>ConstructMetal</constructEffect>
        <repairEffect>Repair</repairEffect>
        <rotatable>false</rotatable>
    </ThingDef>

</Defs>
