<?xml version="1.0" encoding="utf-8"?>
<!--
  1.6 兼容补丁。

  根目录 Defs 采用 AutoBlink 1.7 的原生「Source + Profile」写法，
  但 1.6 版 AutoBlink 仍只有旧版 CompProperties_AutoBlink / HediffCompProperties_AutoBlink，
  因此在 Def 解析前把它们替换回 1.6 的旧写法，避免「找不到类型」的加载错误。

  AutoBlink 未安装时整个补丁跳过（根目录 Defs 里的新 li 自身带 MayRequire，同样会被跳过）。
-->
<Patch>
    <Operation Class="PatchOperationFindMod">
        <mods>
            <!-- PatchOperationFindMod 按 ModMetaData.Name 匹配，这里对应 AutoBlink 的 About.xml name。 -->
            <li>AutoBlink</li>
        </mods>
        <match Class="PatchOperationSequence">
            <operations>

                <!-- 人造人女仆本体 -->
                <li Class="PatchOperationReplace">
                    <xpath>Defs/AlienRace.ThingDef_AlienRace[defName="ArtificialMaid"]/comps/li[@Class="AutoBlink.CompProperties_AutoBlinkSource"]</xpath>
                    <value>
                        <li Class="AutoBlink.CompProperties_AutoBlink" MayRequire="rabiosus.autoblink">
                            <minDistanceToBlink>5</minDistanceToBlink>
                            <maxDistanceToBlink>3000</maxDistanceToBlink>
                            <blinkIntervalTicks>30</blinkIntervalTicks>
                            <delayAfterEligibleTicks>0</delayAfterEligibleTicks>
                            <cellsBeforeTarget>1</cellsBeforeTarget>
                            <postBlinkStanceTicks>30</postBlinkStanceTicks>
                            <defaultAutoBlinkDrafted>true</defaultAutoBlinkDrafted>
                            <defaultAutoBlinkIdle>true</defaultAutoBlinkIdle>
                            <defaultJumpAsFarAsPossible>true</defaultJumpAsFarAsPossible>
                            <playerFactionOnly>true</playerFactionOnly>
                            <excludedJobDefs>
                                <!-- 闲逛时 -->
                                <li>GotoWander</li>
                                <!-- 被携带搬运时 -->
                                <li>Carried</li>
                            </excludedJobDefs>
                            <drawGizmo>true</drawGizmo>
                            <gizmoIconPath>UI/Commands/AutoBlink</gizmoIconPath>
                            <preBlinkSoundDefs>
                                <li>AutoBlink_Skip_Small</li>
                            </preBlinkSoundDefs>
                            <preBlinkEffecterDefs>
                                <li>Skip_Entry</li>
                            </preBlinkEffecterDefs>
                            <postBlinkSoundDefs>
                                <li>AutoBlink_Skip_Exit_Small</li>
                            </postBlinkSoundDefs>
                            <postBlinkEffecterDefs>
                                <li>Skip_ExitNoDelay</li>
                            </postBlinkEffecterDefs>
                        </li>
                    </value>
                </li>

                <!-- 人造人女仆身边光环 -->
                <li Class="PatchOperationReplace">
                    <xpath>Defs/HediffDef[defName="ArtificialMaidAura"]/comps/li[@Class="AutoBlink.HediffCompProperties_AutoBlinkSource"]</xpath>
                    <value>
                        <li Class="AutoBlink.HediffCompProperties_AutoBlink" MayRequire="rabiosus.autoblink">
                            <minDistanceToBlink>5</minDistanceToBlink>
                            <maxDistanceToBlink>300</maxDistanceToBlink>
                            <blinkIntervalTicks>60</blinkIntervalTicks>
                            <delayAfterEligibleTicks>40</delayAfterEligibleTicks>
                            <cellsBeforeTarget>1</cellsBeforeTarget>
                            <postBlinkStanceTicks>30</postBlinkStanceTicks>
                            <defaultAutoBlinkDrafted>true</defaultAutoBlinkDrafted>
                            <defaultAutoBlinkIdle>true</defaultAutoBlinkIdle>
                            <defaultJumpAsFarAsPossible>true</defaultJumpAsFarAsPossible>
                            <playerFactionOnly>true</playerFactionOnly>
                            <excludedJobDefs>
                                <!-- 闲逛时 -->
                                <li>GotoWander</li>
                                <!-- 被携带搬运时 -->
                                <li>Carried</li>
                            </excludedJobDefs>
                            <drawGizmo>true</drawGizmo>
                            <gizmoIconPath>UI/Commands/AutoBlink</gizmoIconPath>
                            <preBlinkSoundDefs>
                                <li>AutoBlink_Skip_Small</li>
                            </preBlinkSoundDefs>
                            <preBlinkEffecterDefs>
                                <li>Skip_Entry</li>
                            </preBlinkEffecterDefs>
                            <postBlinkSoundDefs>
                                <li>AutoBlink_Skip_Exit_Small</li>
                            </postBlinkSoundDefs>
                            <postBlinkEffecterDefs>
                                <li>Skip_ExitNoDelay</li>
                            </postBlinkEffecterDefs>
                        </li>
                    </value>
                </li>

            </operations>
        </match>
    </Operation>
</Patch>
