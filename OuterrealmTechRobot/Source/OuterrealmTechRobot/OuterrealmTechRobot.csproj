  <!-- ===== 双版本构建开关（1.6 / 1.7） =====
       用法（任选其一）：
         MSBuild -p:Configuration=Debug                       → 构建 1.6，输出到 ..\..\1.6\Assemblies\
         MSBuild -p:Configuration=Debug -p:RimWorldVersion=1.7 → 构建 1.7，输出到 ..\..\1.7\Assemblies\
         MSBuild -p:Configuration=Debug17                     → 配置名以 17 结尾时自动判定为 1.7
       游戏根目录可用 -p:RimWorldDirV16=... / -p:RimWorldDirV17=... 覆盖。
       版本宏：1.6 → RIMWORLD_16，1.7 → RIMWORLD_17。 -->
  <PropertyGroup>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == '' and $(Configuration.EndsWith('17'))">1.7</RimWorldVersion>
    <RimWorldVersion Condition="'$(RimWorldVersion)' == ''">1.6</RimWorldVersion>
    <RimWorldDirV16 Condition="'$(RimWorldDirV16)' == ''">..\..\..\..\..\RimWorld-16\</RimWorldDirV16>
    <RimWorldDirV17 Condition="'$(RimWorldDirV17)' == ''">..\..\..\..\</RimWorldDirV17>
  </PropertyGroup>
  <!-- 1.6：完整 Unity 程序集族位于 RimWorldWin64_Data\Managed；1.7（Waylith）只提供 Assembly-CSharp + UnityStubs 桩。 -->
  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.6'">
    <GameAssembliesDir>$(RimWorldDirV16)RimWorldWin64_Data\Managed\</GameAssembliesDir>
    <ModAssembliesDir>..\..\1.6\Assemblies\</ModAssembliesDir>
    <VersionDefine>RIMWORLD_16</VersionDefine>
  </PropertyGroup>
  <PropertyGroup Condition="'$(RimWorldVersion)' == '1.7'">
    <GameAssembliesDir>$(RimWorldDirV17)</GameAssembliesDir>
    <ModAssembliesDir>..\..\1.7\Assemblies\</ModAssembliesDir>
    <VersionDefine>RIMWORLD_17</VersionDefine>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(ModAssembliesDir)</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(RimWorldVersion)\</IntermediateOutputPath>
    <DefineConstants>DEBUG;TRACE;$(VersionDefine)</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>$(ModAssembliesDir)</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(RimWorldVersion)\</IntermediateOutputPath>
    <DefineConstants>TRACE;$(VersionDefine)</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug17|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>$(ModAssembliesDir)</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(RimWorldVersion)\</IntermediateOutputPath>
    <DefineConstants>DEBUG;TRACE;$(VersionDefine)</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release17|AnyCPU' ">
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>$(ModAssembliesDir)</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)\$(RimWorldVersion)\</IntermediateOutputPath>
    <DefineConstants>TRACE;$(VersionDefine)</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
