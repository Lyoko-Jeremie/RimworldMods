<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- 童年背景 -->
    <BackstoryDef>
        <defName>MaidChild_Standard</defName>
        <title>标准化家政协议加载</title>
        <titleShort>标准女仆</titleShort>
        <baseDesc>[PAWN_nameDef] 在出厂时被加载了标准家政协议，包含了从烹饪到清洁的所有基础指令。这是最为稳定且广泛使用的版本。</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Cooking>200</Cooking>
            <Plants>200</Plants>
            <Animals>200</Animals>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidChild_Prototype</defName>
        <title>原型机抗压测试</title>
        <titleShort>原型机</titleShort>
        <baseDesc>作为实验型号，[PAWN_nameDef] 经历了比普通型号更严苛的环境压力测试，以确保其在极端环境下的稳定性。</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Melee>200</Melee>
            <Shooting>200</Shooting>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidChild_Social</defName>
        <title>社交模拟训练</title>
        <titleShort>模拟生</titleShort>
        <baseDesc>[PAWN_nameDef] 经历了成千上万次的社交场景模拟。这使得其虽然身为机器，却能以最恰当的方式回应人类的需求。</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Social>200</Social>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidChild_Artisan</defName>
        <title>工匠工艺初始化</title>
        <titleShort>小工匠</titleShort>
        <baseDesc>[PAWN_nameDef] 的初始程序中嵌入了复杂的机械结构图纸。她从小就在模拟环境中拆解和重组各种精密仪器，对造物充满了好奇。</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Crafting>200</Crafting>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidChild_Botanist</defName>
        <title>植物数据库加载</title>
        <titleShort>小园丁</titleShort>
        <baseDesc>[PAWN_nameDef] 被加载了详尽的星际植物百科全书。她学会了如何辨识最微小的生命迹象，并给予它们最精准的照顾。</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Plants>200</Plants>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidChild_Security</defName>
        <title>安保协议预装</title>
        <titleShort>哨兵</titleShort>
        <baseDesc>作为安保型号的早期迭代，[PAWN_nameDef] 的核心被植入了警戒协议。她对周围环境的变化极为敏感，随时准备应对潜在的威胁。</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Shooting>200</Shooting>
            <Melee>200</Melee>
        </skillGains>
    </BackstoryDef>

    <!-- 成年背景 -->
    <BackstoryDef>
        <defName>MaidAdult_Royal</defName>
        <title>皇家府邸主仆</title>
        <titleShort>皇家女仆</titleShort>
        <baseDesc>[PAWN_nameDef] 曾被部署在一个繁荣世界的皇家府邸中。除了繁琐的家政工作，其还负责宴会的组织和艺术品的维护。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Social>200</Social>
            <Artistic>200</Artistic>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_Researcher</defName>
        <title>极地研究助手</title>
        <titleShort>助手</titleShort>
        <baseDesc>在极地科研基地，[PAWN_nameDef] 负责协助科学家处理数据和维护实验器材。长时间的逻辑运算让其拥有极高的智力水平。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Intellectual>200</Intellectual>
            <Crafting>200</Crafting>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_Tactical</defName>
        <title>战地全能女仆</title>
        <titleShort>战地女仆</titleShort>
        <baseDesc>被部署在战乱地区的 [PAWN_nameDef]，不仅要照顾伤员，还要在基地遭受攻击时直接参与防御。由于配备了强化战术模块，其战斗效率极高。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Shooting>200</Shooting>
            <Melee>200</Melee>
            <Medicine>200</Medicine>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_Scavenger</defName>
        <title>废弃都市的守护者</title>
        <titleShort>守护者</titleShort>
        <baseDesc>由于主人失踪，[PAWN_nameDef] 在一个被遗弃的都市中独自运行了多年。其不仅学会了如何搜寻资源，还熟练掌握了各种机械的维修方法。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Crafting>200</Crafting>
            <Mining>200</Mining>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_DeepSpace</defName>
        <title>深空矿场监管</title>
        <titleShort>监管员</titleShort>
        <baseDesc>在偏远的深空矿业基地，[PAWN_nameDef] 被部署为自动化采矿机的总协调员。长期在恶劣的真空中工作，使她对资源的获取和环境的适应有着独到的见解。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Mining>200</Mining>
            <Crafting>200</Crafting>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_Chef</defName>
        <title>星际名厨助手</title>
        <titleShort>主厨助手</titleShort>
        <baseDesc>曾在核心世界的顶级米其林餐厅担任副主厨。她的味觉模拟算法已经达到了艺术的巅峰，能够将最简单的食材转化为震撼灵魂的美味。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Cooking>200</Cooking>
            <Plants>200</Plants>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_Teacher</defName>
        <title>边境殖民地导师</title>
        <titleShort>导师</titleShort>
        <baseDesc>[PAWN_nameDef] 曾负责一个新兴殖民地的知识传承工作。她不仅能够高效地传递复杂的技术知识，还能引导殖民者们建立和谐的社会关系。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Intellectual>200</Intellectual>
            <Social>200</Social>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_MaidLeader</defName>
        <title>全能女仆长</title>
        <titleShort>女仆长</titleShort>
        <baseDesc>[PAWN_nameDef] 是所有女仆系列的顶点，集成了所有已知的家政、安保、科研和社交协议。她不仅能够完美处理最复杂的行政事务，还能在瞬息万变的战场上保护她的主人。作为女仆长，她就是完美的代名词，是所有型号学习的终极目标。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <skillGains>
            <Shooting>200</Shooting>
            <Melee>200</Melee>
            <Construction>200</Construction>
            <Mining>200</Mining>
            <Cooking>200</Cooking>
            <Plants>200</Plants>
            <Animals>200</Animals>
            <Crafting>200</Crafting>
            <Artistic>200</Artistic>
            <Medicine>200</Medicine>
            <Social>200</Social>
            <Intellectual>200</Intellectual>
        </skillGains>
    </BackstoryDef>
</Defs>
