<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- 童年背景 -->
    <BackstoryDef>
        <defName>MaidChild_Nurturer</defName>
        <title>摇篮培育者</title>
        <titleShort>母亲角色</titleShort>
        <baseDesc>在物质极度充裕的超维世界，[PAWN_nameDef] 从主人出生的第一秒起就守护在侧。作为主人的第一任“母亲”，她不仅提供完美的生理照顾，更以温柔的引导塑造了主人最初的人格，是主人生命中温暖的源泉。</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Social>200</Social>
            <Medicine>200</Medicine>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidChild_Companion</defName>
        <title>青梅竹马</title>
        <titleShort>玩伴</titleShort>
        <baseDesc>[PAWN_nameDef] 与主人一同在花海与云端中长大。她是主人最好的玩伴与兄弟。在那些漫长的午后，她们共同探索这个随心所欲的世界，分享着每一个童年的秘密与欢笑，建立了超越血缘的深厚羁绊。</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Melee>200</Melee>
            <Social>200</Social>
            <Animals>200</Animals>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidChild_Academic</defName>
        <title>学识同桌</title>
        <titleShort>同桌</titleShort>
        <baseDesc>在超维科技的教育殿堂中，[PAWN_nameDef] 是主人的同桌。她不仅是协助主人掌握复杂知识的智慧终端，更是与主人一同竞赛、一同进步的伙伴。在枯燥的理论学习中，她的陪伴让知识变得甜美。</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Intellectual>200</Intellectual>
            <Social>200</Social>
            <Crafting>200</Crafting>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidChild_Emotional</defName>
        <title>心灵共鸣者</title>
        <titleShort>精神挚友</titleShort>
        <baseDesc>在这个欲望即得的世界，[PAWN_nameDef] 的核心程序被优化为精准感知主人的每一次情绪波动。她是主人从小到大最亲密的朋友与倾听者，确保主人的心灵始终处于最平和、最快乐的状态。</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Social>200</Social>
            <Artistic>200</Artistic>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidChild_GuardianSister</defName>
        <title>守护长姐</title>
        <titleShort>姐姐</titleShort>
        <baseDesc>[PAWN_nameDef] 扮演着温柔而强大的“姐姐”角色。在主人探索未知的边界时，她总是默默守护在侧，用那双纤细却有力的手挡掉所有的意外，给主人最坚实的依靠。</baseDesc>
        <slot>Childhood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Shooting>200</Shooting>
            <Melee>200</Melee>
        </skillGains>
    </BackstoryDef>

    <!-- 成年背景 -->
    <BackstoryDef>
        <defName>MaidAdult_Partner</defName>
        <title>完美恋人</title>
        <titleShort>妻子/女友</titleShort>
        <baseDesc>随着主人步入成年，[PAWN_nameDef] 完美地转变为伴侣的角色。她是温柔体贴的妻子，也是热情烂漫的女友。在理想世界的每一天，她都致力于将生活经营成诗，给予主人全方位的爱与归宿。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Social>200</Social>
            <Cooking>200</Cooking>
            <Artistic>200</Artistic>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_SpiritualMentor</defName>
        <title>心灵导师</title>
        <titleShort>导师</titleShort>
        <baseDesc>在物质已不再是追求的超维时代，[PAWN_nameDef] 承担起了引导主人精神境界的重任。她是智者、是灯塔，在哲学与艺术的海洋中引领主人探索宇宙的真谛，防止主人在无限的享乐中迷失自我。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Social>200</Social>
            <Intellectual>200</Intellectual>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_DesireFulfillment</defName>
        <title>欲望中枢</title>
        <titleShort>欲望容器</titleShort>
        <baseDesc>[PAWN_nameDef] 是主人最私密的需求处理终端。无论是生理上的极致释放，还是情感上的倾吐，她都以绝对的包容和热爱去接纳与转化。她是主人的减压阀，也是主人探索快乐边界的终极工具。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Social>200</Social>
            <Medicine>200</Medicine>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_CreativePartner</defName>
        <title>艺术合伙人</title>
        <titleShort>事业伴侣</titleShort>
        <baseDesc>在主人的创作与科研活动中，[PAWN_nameDef] 是不可或缺的灵魂搭档。她能够与主人的思想完美同步，将主人的奇思妙想转化为现实。无论是宏大的超维工程还是细腻的艺术雕琢，她都是最完美的协作者。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Crafting>200</Crafting>
            <Construction>200</Construction>
            <Intellectual>200</Intellectual>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_UltimateGuardian</defName>
        <title>终极守卫</title>
        <titleShort>影卫</titleShort>
        <baseDesc>虽然超维世界已经基本消灭了暴力，但 [PAWN_nameDef] 依然维持着最高等级的警惕。她是主人身后的影子，在主人进行维度旅行和虚空探索时，以优雅的方式清除任何威胁，确保主人万无一失。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Shooting>200</Shooting>
            <Melee>200</Melee>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_EcoSteward</defName>
        <title>生态管家</title>
        <titleShort>星园师</titleShort>
        <baseDesc>[PAWN_nameDef] 负责打理主人私人领地的整个生态系统。她对动植物有着超越自然的亲和力，能将蛮荒的星球雕琢成繁花似锦的伊甸园，让主人的每一个晨昏都能在最自然的怀抱中醒来。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Plants>200</Plants>
            <Animals>200</Animals>
            <Cooking>200</Cooking>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_ResourceOrchestrator</defName>
        <title>弦场工程师</title>
        <titleShort>弦乐师</titleShort>
        <baseDesc>在这个能量即万物的时代，[PAWN_nameDef] 管理着主人的能量节点与物质转换装置。她以极高的响应主人的需求，确保主人那随心所欲的生活背后有着永不枯竭的物质能量支撑。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Mining>200</Mining>
            <Crafting>200</Crafting>
            <Intellectual>200</Intellectual>
        </skillGains>
    </BackstoryDef>

    <BackstoryDef>
        <defName>MaidAdult_MaidLeader</defName>
        <title>全能女仆长</title>
        <titleShort>女仆长</titleShort>
        <baseDesc>作为“全能女仆长”，[PAWN_nameDef] 是超维科技的终极产物，是主人生命中所有温柔与力量的化身。她不仅能以绝对的武力扫清星辰间的阻碍，更能以无限的包容填补灵魂的每一个缝隙。在她的设计中，母亲的哺育、童年的嬉戏、求知的探索与成年的深情被完美交织在一起。她是主人的导师、挚友、兄弟与唯一的恋人，是欲望的终点，也是生命的归宿。作为所有型号的顶点，她代表着这个世界对个体最极致的宠溺与爱奉。</baseDesc>
        <slot>Adulthood</slot>
        <spawnCategories>
            <li>ArtificialMaidBackstory</li>
        </spawnCategories>
        <requiresSpawnCategory>true</requiresSpawnCategory>
        <skillGains>
            <Shooting>200</Shooting>
            <Melee>200</Melee>
            <Construction>200</Construction>
            <Mining>200</Mining>
            <Cooking>200</Cooking>
            <Plants>200</Plants>
            <Animals>200</Animals>
            <Crafting>200</Crafting>
            <Artistic>200</Artistic>
            <Medicine>200</Medicine>
            <Social>200</Social>
            <Intellectual>200</Intellectual>
        </skillGains>
    </BackstoryDef>
</Defs>
