<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThingDef ParentName="BuildingBase">
        <defName>ArtificialMaidDisplayCase</defName>
        <label>artificial maid display case</label>
        <description>A specialized display case designed to house and temporarily deactivate idle Artificial Maids. It keeps them in a state of stasis to conserve energy and reduce cognitive overhead, while remaining visually pleasing for display. It can be configured to automatically hibernate idle maids and wake them when work is available.</description>
        <thingClass>OuterrealmTechRobot.Building_ArtificialMaidDisplayCase</thingClass>
        <tickerType>Normal</tickerType>
        <graphicData>
            <texPath>Things/Building/Production/OmniCrafter2_l</texPath>
            <graphicClass>Graphic_Single</graphicClass>
            <drawSize>(1,2)</drawSize>
            <shaderType>CutoutComplex</shaderType>
        </graphicData>
        <altitudeLayer>Building</altitudeLayer>
        <drawerType>MapMeshAndRealTime</drawerType>
        <passability>PassThroughOnly</passability>
        <pathCost>1</pathCost>
        <blockWind>false</blockWind>
        <castEdgeShadows>false</castEdgeShadows>
        <staticSunShadowHeight>0.0</staticSunShadowHeight>
        <fillPercent>0.5</fillPercent>
        <canOverlapZones>false</canOverlapZones>
        <statBases>
            <MaxHitPoints>250</MaxHitPoints>
            <WorkToBuild>2000</WorkToBuild>
            <Mass>20</Mass>
            <Flammability>0.5</Flammability>
            <Beauty>20</Beauty>
        </statBases>
        <size>(1,2)</size>
        <costList>
            <Steel>100</Steel>
            <ComponentIndustrial>5</ComponentIndustrial>
        </costList>
        <building>
            <isPlayerEjectable>true</isPlayerEjectable>
        </building>
        <designationCategory>OmniCrafter_Category</designationCategory>
        <hasInteractionCell>true</hasInteractionCell>
        <interactionCellOffset>(0,0,-1)</interactionCellOffset>
        <comps>
        </comps>
    </ThingDef>
</Defs>
