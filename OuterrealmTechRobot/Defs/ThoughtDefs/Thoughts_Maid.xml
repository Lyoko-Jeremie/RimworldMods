<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <ThoughtDef>
        <defName>MaidEmotionalSupport</defName>
        <durationDays>0.5</durationDays>
        <stackLimit>5</stackLimit>
        <stages>
            <li>
                <label>女仆的情感支持</label>
                <description>那位女仆总是能理解我的感受，并给我最贴心的安慰。感觉压力都消失了。</description>
                <baseMoodEffect>10</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ArtificialMaidMasterProtocol_Mood</defName>
        <durationDays>1</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>超维协议庇护</label>
                <description>在超维科技的纳米阵列庇护下，我感到前所未有的安心。身体的伤痛在瞬间消失，精神也得到了极大的振奋。</description>
                <baseMoodEffect>20</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

    <ThoughtDef>
        <defName>ArtificialMaidAura_Mood</defName>
        <durationDays>1</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>女仆在身边</label>
                <description>人造人女仆的能量场环绕着我，身心都感到无比安定与自信。</description>
                <baseMoodEffect>20</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>


    <ThoughtDef>
        <defName>ArtificialMaidSubdued_Mood</defName>
        <durationDays>1</durationDays>
        <stackLimit>1</stackLimit>
        <stages>
            <li>
                <label>被超维科技制服</label>
                <description>超维科技的控制场封锁了我的全部机能：无法行动、无法反抗，只剩下意识在黑暗中漂浮。</description>
                <baseMoodEffect>-10</baseMoodEffect>
            </li>
        </stages>
    </ThoughtDef>

</Defs>