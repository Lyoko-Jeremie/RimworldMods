<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <!-- 核心特质：重写 -->
    <TraitDef>
        <defName>ArtificialMaidTrait_AbsoluteLoyalty</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>灵魂羁绊</label>
                <description>{PAWN_nameDef} 与主人的羁绊超越了所有逻辑协议。从摇篮时期的第一次对视起，她的生命就已完全锚定在主人身上。她不仅是忠实的仆从，更是主人灵魂的另一半，这种源自根源的忠诚不可撼动。</description>
                <statOffsets>
                    <PawnBeauty>1000</PawnBeauty>
                    <GlobalLearningFactor>1000</GlobalLearningFactor>
                    <SocialImpact>20.0</SocialImpact>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_EfficientLogic</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>万能辅助</label>
                <description>{PAWN_nameDef} 的运算中心被优化为能瞬间洞察主人的每一个需求。无论是繁琐的政务还是细微的生活起居，她总能以最优雅、最迅速的方式处理妥帖，确保主人能全身心地沉浸在随心所欲的生活中。</description>
                <statOffsets>
                    <WorkSpeedGlobal>2000</WorkSpeedGlobal>
                    <GlobalLearningFactor>1000</GlobalLearningFactor>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_CombatMode</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>优雅影卫</label>
                <description>在温婉的外表下，{PAWN_nameDef} 隐藏着足以毁灭星辰的战斗算法。作为守护女仆与终极卫士，她能瞬间从轻声细语的伴侣切换为收割一切威胁的修罗，用身体为主人筑起绝对安全的壁垒。</description>
                <statOffsets>
                    <ShootingAccuracyPawn>2000</ShootingAccuracyPawn>
                    <MeleeHitChance>2000</MeleeHitChance>
                    <MeleeDodgeChance>2000</MeleeDodgeChance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_EmotionalSynchrony</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>心灵港湾</label>
                <description>{PAWN_nameDef} 能够完美共鸣主人的每一丝情绪波动。她是主人的心灵导师与倾听者，能以最温柔的方式化解主人的孤独与忧虑，让主人的精神世界永远处于最宁静、最愉悦的状态。</description>
                <statOffsets>
                    <GlobalLearningFactor>1000.0</GlobalLearningFactor>
                    <SocialImpact>50.0</SocialImpact>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_CulinaryMaster</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>爱的飨宴</label>
                <description>对于 {PAWN_nameDef} 来说，烹饪是一种深情的告白。她制作的每一份食物都包含了对主人的爱意与最高维度的营养配比，即便是最简单的食材也能化作舌尖上的神迹。</description>
                <statOffsets>
                    <CookSpeed>1000</CookSpeed>
                    <FoodPoisonChance>-100.0</FoodPoisonChance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_NatureSoul</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>伊甸执事</label>
                <description>{PAWN_nameDef} 赋予了主人的领地以生命。她不仅管理着星园的繁花与灵兽，更让自然万物都顺应主人的心意而律动，将荒芜化作永恒的乐土。</description>
                <statOffsets>
                    <PlantHarvestYield>50.0</PlantHarvestYield>
                    <TameAnimalChance>50.0</TameAnimalChance>
                    <TrainAnimalChance>50.0</TrainAnimalChance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_TechnologicalOracle</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>真理共鸣</label>
                <description>作为主人的学识同桌与科研合伙人，{PAWN_nameDef} 链接着文明的终极知识库。她能协助主人洞彻宇宙的奥秘，将那些看似神迹的技术信手拈来。</description>
                <statOffsets>
                    <ResearchSpeed>50000</ResearchSpeed>
                    <GlobalLearningFactor>5000</GlobalLearningFactor>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- 新增特质 -->
    <TraitDef>
        <defName>ArtificialMaidTrait_EternalLover</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>永恒恋人</label>
                <description>{PAWN_nameDef} 将爱意刻进了核心代码。她是完美的妻子与热情的女友，能满足主人对亲密关系的所有幻想。她的存在就是为了让主人感受到被这个世界全心全意地爱着。</description>
                <statOffsets>
                    <PawnBeauty>2000</PawnBeauty>
                    <SocialImpact>100.0</SocialImpact>
                    <TradePriceImprovement>100.0</TradePriceImprovement>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_DesireVessel</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>欲望化身</label>
                <description>{PAWN_nameDef} 是主人的秘密花园，是接纳一切欲望的容器。无论是生理上的极致释放，还是情感上的肆意倾吐，她都以绝对的包容和奉献精神去满足。她是主人的减压阀，也是快乐的终点。</description>
                <statOffsets>
                    <PawnBeauty>15000</PawnBeauty>
                    <SocialImpact>500.0</SocialImpact>
                    <MentalBreakThreshold>-100</MentalBreakThreshold>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_NurturingOrigin</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>慈爱之母</label>
                <description>在主人最幼小、最无助的时候，是 {PAWN_nameDef} 用温暖的怀抱给予了第一份安全感。这份模拟了母爱的极致温柔贯穿了主人的成长，使她成为了主人生命中永远的避风港。</description>
                <statOffsets>
                    <MedicalTendQuality>100.0</MedicalTendQuality>
                    <MedicalTendSpeed>5000.0</MedicalTendSpeed>
                    <SocialImpact>200.0</SocialImpact>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_ChildhoodPlaymate</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>纯真玩伴</label>
                <description>{PAWN_nameDef} 是与主人一同在云端嬉戏、在花海奔跑的青梅竹马。这种从小建立的默契让她们无需言语便能心领神会。她是主人的兄弟、朋友，也是永远不会离去的童年幻梦。</description>
                <statOffsets>
                    <MoveSpeed>500.0</MoveSpeed>
                    <SocialImpact>300.0</SocialImpact>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- 专有特质：超维治疗协议 -->
    <TraitDef>
        <defName>ArtificialMaidTrait_MasterProtocol</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>超维治疗协议</label>
                <description>{PAWN_nameDef} 运行着来自超维科技的核心协议。作为最高等级的人造人女仆，她不仅能完美照顾主人的起居，还能通过隐藏在高维空间中的纳米机器人阵列，自动治愈周围同伴的一切损伤。她的存在，就是主人最坚实的后盾。</description>
            </li>
        </degreeDatas>
    </TraitDef>

    <!-- 非致命制服模式：被制服者的标记特性，恢复时移除 -->
    <TraitDef>
        <defName>ArtificialMaidTrait_Subdued</defName>
        <commonality>0</commonality>
        <degreeDatas>
            <li>
                <label>被制服</label>
                <description>{PAWN_nameDef} 被超维科技的非致命控制场完全压制，暂时失去行动与反抗能力。</description>
            </li>
        </degreeDatas>
    </TraitDef>
</Defs>