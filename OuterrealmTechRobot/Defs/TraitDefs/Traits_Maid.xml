<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <TraitDef>
        <defName>ArtificialMaidTrait_AbsoluteLoyalty</defName>
        <commonality>0.5</commonality>
        <degreeDatas>
            <li>
                <label>绝对忠诚</label>
                <description>{PAWN_nameDef} 的忠诚协议被锁定在最高优先级别。她不仅会无条件服从指令，其温和且坚定的态度也会让周围的人感到安心。</description>
                <statOffsets>
                    <PawnBeauty>100</PawnBeauty>
                    <GlobalLearningFactor>10</GlobalLearningFactor>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_EfficientLogic</defName>
        <commonality>0.5</commonality>
        <degreeDatas>
            <li>
                <label>高效逻辑</label>
                <description>处理器的运算逻辑经过了深度优化，能够以最快的速度分析并完成分配的任务。</description>
                <statOffsets>
                    <WorkSpeedGlobal>10</WorkSpeedGlobal>
                    <GlobalLearningFactor>10</GlobalLearningFactor>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_CombatMode</defName>
        <commonality>0.2</commonality>
        <degreeDatas>
            <li>
                <label>战斗模式激活</label>
                <description>这台人造人内部集成了非公开的战斗战术模块。在需要时，她可以从温婉的女仆瞬间切换为高效的杀戮机器。</description>
                <statOffsets>
                    <ShootingAccuracyPawn>200</ShootingAccuracyPawn>
                    <MeleeHitChance>200</MeleeHitChance>
                    <MeleeDodgeChance>200</MeleeDodgeChance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_EmotionalSynchrony</defName>
        <commonality>0.3</commonality>
        <degreeDatas>
            <li>
                <label>情感同步</label>
                <description>通过微表情分析和费洛蒙感应，{PAWN_nameDef} 能完美同步周围人类的情绪并提供恰到好处的安慰。只要她在身边，大家都会感到心情愉悦。</description>
                <statOffsets>
                    <GlobalLearningFactor>10.0</GlobalLearningFactor>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_CulinaryMaster</defName>
        <commonality>0.2</commonality>
        <degreeDatas>
            <li>
                <label>烹饪大师</label>
                <description>{PAWN_nameDef} 拥有一套顶级烹饪算法。她制作的食物不仅味道绝佳，而且速度惊人。</description>
                <statOffsets>
                    <CookSpeed>1000</CookSpeed>
                    <FoodPoisonChance>-100.0</FoodPoisonChance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_NatureSoul</defName>
        <commonality>0.2</commonality>
        <degreeDatas>
            <li>
                <label>自然之魂</label>
                <description>{PAWN_nameDef} 对自然界的生命力有着独特的感知力。她能够与植物和动物进行某种深层次的“通讯”。</description>
                <statOffsets>
                    <PlantHarvestYield>20.0</PlantHarvestYield>
                    <TameAnimalChance>20.0</TameAnimalChance>
                    <TrainAnimalChance>20.0</TrainAnimalChance>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>

    <TraitDef>
        <defName>ArtificialMaidTrait_TechnologicalOracle</defName>
        <commonality>0.1</commonality>
        <degreeDatas>
            <li>
                <label>技术神谕</label>
                <description>这台人造人的处理器中似乎连接着某个古老且庞大的技术知识库。在进行科学研究时，她展现出的效率几乎等同于神谕。</description>
                <statOffsets>
                    <ResearchSpeed>50000</ResearchSpeed>
                    <GlobalLearningFactor>5000</GlobalLearningFactor>
                </statOffsets>
            </li>
        </degreeDatas>
    </TraitDef>
</Defs>
