<?xml version="1.0" encoding="utf-8"?>
<Defs>
    <AlienRace.ThingDef_AlienRace ParentName="BasePawn">
        <defName>ArtificialMaid</defName>
        <label>artificial maid</label>
        <description>A highly advanced artificial maid designed for perfection. She has unlimited work efficiency, no needs, no risk of mental break, and an indestructible body.</description>
        <alienRace>
            <generalSettings>
                <maleGenderProbability>0</maleGenderProbability>
                <immuneToAge>true</immuneToAge>
                <canLayDown>true</canLayDown>
                <maxDamageForSocialfight>0</maxDamageForSocialfight>
                <immuneToXenophobia>true</immuneToXenophobia>
                <childBackstoryFilter>
                    <li>
                        <categories>
                            <li>ArtificialMaidBackstory</li>
                        </categories>
                    </li>
                </childBackstoryFilter>
                <adultBackstoryFilter>
                    <li>
                        <categories>
                            <li>ArtificialMaidBackstory</li>
                        </categories>
                    </li>
                </adultBackstoryFilter>
                <alienPartGenerator>
                    <headTypes>
                        <li>Female_AverageNormal</li>
                        <li>Female_AveragePointy</li>
                        <li>Female_AverageWide</li>
                        <li>Female_NarrowNormal</li>
                        <li>Female_NarrowPointy</li>
                        <li>Female_NarrowWide</li>
                    </headTypes>
                    <bodyTypes>
                        <li>Female</li>
                    </bodyTypes>
                </alienPartGenerator>
                <raceGenes>
                    <li>ArtificialMaid_Core</li>
                </raceGenes>
            </generalSettings>
            <graphicPaths>
                <body>Things/Pawn/Humanlike/Bodies/</body>
                <head>Things/Pawn/Humanlike/Heads/</head>
                <skinShader>CutoutSkin</skinShader>
            </graphicPaths>
            <thoughtSettings>
                <cannotReceiveThoughtsAtAll>true</cannotReceiveThoughtsAtAll>
            </thoughtSettings>
            <raceRestriction>
                <whiteXenotypeList>
                    <li>ArtificialMaidXenotype</li>
                </whiteXenotypeList>
                <whiteGeneList>
                    <li>ArtificialMaid_Core</li>
                </whiteGeneList>
                <blackGeneList>
                    <li MayRequire="Ludeon.RimWorld.Biotech">ViolenceDisabled</li>
                </blackGeneList>
            </raceRestriction>
        </alienRace>
        <statBases>
            <MarketValue>100000</MarketValue> <!-- 市场价值 -->
            <MoveSpeed>1000</MoveSpeed> <!-- 移动速度 -->
            <CrawlSpeed>1000</CrawlSpeed> <!-- 爬行速度 -->
            <Flammability>0</Flammability> <!-- 易燃性 -->
            <ComfyTemperatureMin>-273</ComfyTemperatureMin> <!-- 最低舒适温度 -->
            <ComfyTemperatureMax>10000</ComfyTemperatureMax> <!-- 最高舒适温度 -->
            <LeatherAmount>0</LeatherAmount> <!-- 皮革产量 -->
            <MeatAmount>0</MeatAmount> <!-- 肉产量 -->
            <PsychicSensitivity>1.0</PsychicSensitivity> <!-- 精神敏感度 -->
            <ToxicResistance>1</ToxicResistance> <!-- 毒素抗性 -->
            <MaxHitPoints>9999999</MaxHitPoints> <!-- 最大生命值 -->
            <ArmorRating_Sharp>10</ArmorRating_Sharp> <!-- 利器护甲 (1000%) -->
            <ArmorRating_Blunt>10</ArmorRating_Blunt> <!-- 钝器护甲 (1000%) -->
            <ArmorRating_Heat>10</ArmorRating_Heat> <!-- 热能护甲 (1000%) -->
            <Insulation_Cold>10000</Insulation_Cold> <!-- 抗寒绝缘 -->
            <Insulation_Heat>10000</Insulation_Heat> <!-- 抗热绝缘 -->
            <EquipDelay>0</EquipDelay> <!-- 装备延迟 -->
            <WorkSpeedGlobal>9999999</WorkSpeedGlobal> <!-- 全局工作速度 -->
            <CarryingCapacity>10000000</CarryingCapacity> <!-- 搬运能力 -->
            <MentalBreakThreshold>0</MentalBreakThreshold> <!-- 崩溃临界值 -->
            <PainShockThreshold>0</PainShockThreshold> <!-- 疼痛休克临界值 -->
            <MeditationFocusGain>10</MeditationFocusGain> <!-- 冥想效率 (1000%) -->
            <ImmunityGainSpeed>10</ImmunityGainSpeed> <!-- 免疫速度 (1000%) -->
            <MeleeDamageFactor>1000</MeleeDamageFactor> <!-- 近战伤害倍率 (100,000%) -->
            <MeleeArmorPenetration>1000</MeleeArmorPenetration> <!-- 近战护盾穿透 (100,000%) -->
            <MeleeDodgeChance>10</MeleeDodgeChance> <!-- 近战闪避 (1000%) -->
            <MortarMissRadiusFactor>0</MortarMissRadiusFactor> <!-- 迫击炮偏移系数 (0) -->
            <ShootingAccuracyPawn>10</ShootingAccuracyPawn> <!-- 射击精度 (1000%) -->
            <AimingDelayFactor>0.01</AimingDelayFactor> <!-- 瞄准时间 (1%) -->
            <PawnBeauty>100</PawnBeauty> <!-- 魅力 (100) -->
        </statBases>
        <tools>
            <li>
                <label>left fist</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>1000</power>
                <cooldownTime>0.1</cooldownTime>
                <linkedBodyPartsGroup>LeftHand</linkedBodyPartsGroup>
                <surpriseAttack>
                    <extraMeleeDamages>
                        <li>
                            <def>Stun</def>
                            <amount>1000</amount>
                        </li>
                    </extraMeleeDamages>
                </surpriseAttack>
            </li>
            <li>
                <label>right fist</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>1000</power>
                <cooldownTime>0.1</cooldownTime>
                <linkedBodyPartsGroup>RightHand</linkedBodyPartsGroup>
                <surpriseAttack>
                    <extraMeleeDamages>
                        <li>
                            <def>Stun</def>
                            <amount>1000</amount>
                        </li>
                    </extraMeleeDamages>
                </surpriseAttack>
            </li>
            <li>
                <label>teeth</label>
                <capacities>
                    <li>Bite</li>
                </capacities>
                <power>1000</power>
                <cooldownTime>0.1</cooldownTime>
                <linkedBodyPartsGroup>Teeth</linkedBodyPartsGroup>
                <chanceFactor>0.07</chanceFactor>
                <soundMeleeHit>Pawn_Melee_HumanBite_Hit</soundMeleeHit>
                <soundMeleeMiss>Pawn_Melee_HumanBite_Miss</soundMeleeMiss>
            </li>
            <li>
                <label>head</label>
                <capacities>
                    <li>Blunt</li>
                </capacities>
                <power>1000</power>
                <cooldownTime>0.1</cooldownTime>
                <linkedBodyPartsGroup>HeadAttackTool</linkedBodyPartsGroup>
                <ensureLinkedBodyPartsGroupAlwaysUsable>true</ensureLinkedBodyPartsGroupAlwaysUsable>
                <chanceFactor>0.2</chanceFactor>
            </li>
        </tools>
        <race>
            <thinkTreeMain>Humanlike</thinkTreeMain>
            <thinkTreeConstant>HumanlikeConstant</thinkTreeConstant>
            <intelligence>Humanlike</intelligence>
            <renderTree>Humanlike</renderTree>
            <makesFootprints>true</makesFootprints>
            <lifeExpectancy>10000</lifeExpectancy>
            <nameCategory>HumanStandard</nameCategory>
            <body>Human</body>
            <baseBodySize>1</baseBodySize>
            <baseHealthScale>100</baseHealthScale>
            <foodType>None</foodType>
            <needsRest>false</needsRest>
            <alwaysAwake>true</alwaysAwake>
            <gestationPeriodDays>30</gestationPeriodDays>
            <litterSizeCurve>
                <points>
                    <li>(0.5, 0)</li>
                    <li>(1, 1)</li>
                    <li>(1.01, 0)</li>
                </points>
            </litterSizeCurve>
            <lifeStageAges>
                <li>
                    <def>ArtificialMaidLifeStage</def>
                    <minAge>0</minAge>
                </li>
            </lifeStageAges>
            <soundMeleeDodge>Pawn_MeleeDodge</soundMeleeDodge>
            <specialShadowData>
                <volume>(0.3, 0.8, 0.4)</volume>
                <offset>(0,0,-0.3)</offset>
            </specialShadowData>
            <ageGenerationCurve>
                <points>
                    <li>(18,0)</li>
                    <li>(20,100)</li>
                    <li>(30,100)</li>
                    <li>(40,0)</li>
                </points>
            </ageGenerationCurve>
            <hediffGiverSets>
                <li>OrganicStandard</li>
                <li>Human</li>
            </hediffGiverSets>
        </race>
        <comps>
            <li Class="OuterrealmTechRobot.CompProperties_ArtificialMaid" />
            <li Class="AutoBlink.CompProperties_AutoBlink" MayRequire="rabiosus.autoblink">
                <minDistanceToBlink>5</minDistanceToBlink>
                <maxDistanceToBlink>300</maxDistanceToBlink>
                <blinkIntervalTicks>60</blinkIntervalTicks>
                <delayAfterEligibleTicks>40</delayAfterEligibleTicks>
                <cellsBeforeTarget>1</cellsBeforeTarget>
                <postBlinkStanceTicks>30</postBlinkStanceTicks>
                <defaultAutoBlinkDrafted>true</defaultAutoBlinkDrafted>
                <defaultAutoBlinkIdle>true</defaultAutoBlinkIdle>
                <defaultJumpAsFarAsPossible>true</defaultJumpAsFarAsPossible>
                <playerFactionOnly>false</playerFactionOnly>
                <excludedJobDefs>
                    <!-- 闲逛时 -->
                    <li>GotoWander</li>
                    <!-- 被携带搬运时 -->
                    <li>Carried</li>
                </excludedJobDefs>
                <drawGizmo>true</drawGizmo>
                <gizmoIconPath>UI/Commands/AutoBlink</gizmoIconPath>
                <preBlinkSoundDefs>
                    <li>AutoBlink_Skip_Small</li>
                </preBlinkSoundDefs>
                <preBlinkEffecterDefs>
                    <li>Skip_Entry</li>
                </preBlinkEffecterDefs>
                <postBlinkSoundDefs>
                    <li>AutoBlink_Skip_Exit_Small</li>
                </postBlinkSoundDefs>
                <postBlinkEffecterDefs>
                    <li>Skip_ExitNoDelay</li>
                </postBlinkEffecterDefs>
            </li>
        </comps>
    </AlienRace.ThingDef_AlienRace>
</Defs>
